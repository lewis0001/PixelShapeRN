{
  "name": "botforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "fw:build": "pio run -d packages/firmware",
    "fw:test": "pio test -d packages/firmware -e native",
    "e2e": "pnpm --dir apps/web run e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yaml,yml}": "prettier --write",
    "*.py": "uv run --project packages/engine ruff check --fix"
  }
}
