        "docs": {
          "blurb": "The robot's voice \u2014 beeps, chirps and little tunes. Passive type, so the brain wiggles the pin to play each note.",
          "datasheet_url": "",
          "troubleshooting": [
            {
              "symptom": "No sound at all",
              "fix": "Check the + leg (the longer one, marked on top) goes to the yellow signal wire, and that yours is a PASSIVE buzzer \u2014 active ones only play one fixed tone."
            },
            {
              "symptom": "Sound is very quiet",
              "fix": "Seat the buzzer fully in its pocket and make sure the small hole on top isn't covered."
            }
          ]
        },
        "sim": {
