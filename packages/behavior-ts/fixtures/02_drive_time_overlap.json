{
  "name": "02_drive_time_overlap",
  "desc": "drive_time = drive, stored deadline, then drive(0,0). An on_tick handler interleaves (led with explicit pixel id 1 at 80/160/...) while on_start is blocked, proving activations are independent. At t=160 handler order is declaration order: on_start finishes before on_tick fires.",
  "tick_ms": 20,
  "run_ms": 400,
  "sensors": {},
  "random": [],
  "buttons": [],
  "program": {
    "bsj": 1,
    "name": "drive_time_overlap",
    "vars": [],
    "handlers": [
      {
        "event": {
          "type": "on_start"
        },
        "body": [
          {
            "op": "drive_time",
            "l": 50,
            "r": 50,
            "ms": 90
          },
          {
            "op": "tone",
            "hz": 440,
            "ms": 50
          },
          {
            "op": "drive_time",
            "l": -40,
            "r": 40,
            "ms": 50
          },
          {
            "op": "log",
            "msg": "seq done"
          }
        ]
      },
      {
        "event": {
          "type": "on_tick",
          "ms": 80
        },
        "body": [
          {
            "op": "led",
            "r": 10,
            "g": 10,
            "b": 10,
            "id": 1
          }
        ]
      }
    ]
  },
  "expected": [
    "0 drive 50 50",
    "80 led 10 10 10 1",
    "100 drive 0 0",
    "100 tone 440 50",
    "100 drive -40 40",
    "160 drive 0 0",
    "160 log 1 seq done",
    "160 led 10 10 10 1",
    "240 led 10 10 10 1",
    "320 led 10 10 10 1",
    "400 led 10 10 10 1"
  ]
}
