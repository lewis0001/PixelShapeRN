# BOTFORGE environment template.
# Copy to .env.local (web) / .env (scripts) and fill in. NEVER commit real values.
# All of these go live in Phase 4+ — Phase 0-3 need none of them.

# Supabase (Phase 4)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 4/5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# EasyPost (Phase 5)
EASYPOST_API_KEY=

# Resend (Phase 4)
RESEND_API_KEY=

# Anthropic (Phase 5 QC / Phase 7 support agent)
ANTHROPIC_API_KEY=

# Mapbox geocoding (Phase 5 printer certification)
MAPBOX_TOKEN=

# Analytics / monitoring (Phase 4)
